# Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_MODEL=<your-deployment-name>
# Optional: override API version (defaults to latest stable)
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure AI Search configuration (for NOW document indexing)
AZURE_SEARCH_SERVICE_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-key>
AZURE_NOW_SEARCH_INDEX_NAME=now-application-index

# Core API configuration (for NOW application metadata lookups)
MDS_CORE_API_BASE_URL=https://mds-test.apps.silver.devops.gov.bc.ca/api
# Optional bearer token for Core API endpoints that require auth
# MDS_CORE_API_TOKEN=<your-core-api-token>
# Optional OAuth2 client credentials auth (used when MDS_CORE_API_TOKEN is not set)
# MDS_CORE_API_TOKEN_URL=https://test.loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/token
# MDS_CORE_API_CLIENT_ID=<your-client-id>
# MDS_CORE_API_CLIENT_SECRET=<your-client-secret>
# Optional token request params (provider-dependent)
# MDS_CORE_API_TOKEN_SCOPE=<space-delimited-scope>
# MDS_CORE_API_TOKEN_AUDIENCE=<audience>
# MDS_CORE_API_TOKEN_RESOURCE=<resource>
# Optional token call timeout in seconds (default 30)
# MDS_CORE_API_TOKEN_TIMEOUT_S=30
# Optional timeout in seconds (default 30)
# MDS_CORE_API_TIMEOUT_S=30
