{
  "extensions.ignoreRecommendations": true,
  "files.eol": "\n",
  "files.trimFinalNewlines": true,
  "editor.renderWhitespace": "none",
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "eeyore.yapf",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "eslint.autoFixOnSave": "explicit"
  },
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.analysis.typeCheckingMode": "basic",
  "yapf.args": [
    "--style={column_limit:100, spaces_before_comment:'15,30,50', SPLIT_BEFORE_EXPRESSION_AFTER_OPENING_PAREN:TRUE}"
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#7860ba",
    "activityBar.background": "#7860ba",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#593427",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#7860ba",
    "statusBar.background": "#5e46a1",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#7860ba",
    "statusBarItem.remoteBackground": "#5e46a1",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#5e46a1",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#5e46a199",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#5e46a1"
}
