                          class="ant-checkbox-inner"
                        />
                      </span>
                      <span>
                        Project Lead
                         
                        <span
                          aria-label="info-circle"
                          class="anticon anticon-info-circle"
                          role="img"
                        >
                          <svg
                            aria-hidden="true"
                            class=""
                            data-icon="info-circle"
                            fill="currentColor"
                            focusable="false"
                            height="1em"
                            viewBox="64 64 896 896"
                            width="1em"
                          >
                            <path
                              d="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm0 820c-205.4 0-372-166.6-372-372s166.6-372 372-372 372 166.6 372 372-166.6 372-372 372z"
                            />
                            <path
                              d="M464 336a48 48 0 1096 0 48 48 0 10-96 0zm72 112h-48c-4.4 0-8 3.6-8 8v272c0 4.4 3.6 8 8 8h48c4.4 0 8-3.6 8-8V456c0-4.4-3.6-8-8-8z"
                            />
                          </svg>
                        </span>
                      </span>
                    </label>
                  </div>
                </div>
                <div
                  style="display: flex; flex-wrap: nowrap;"
                >
                  <div
                    class="ant-form-item-explain ant-form-item-explain-connected"
                    id="EDIT_FULL_PARTY_set_to_project_lead_help"
                    role="alert"
                  >
                    <div
                      class=""
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="ant-row"
        style="margin-left: -8px; margin-right: -8px;"
      >
        <div
          class="ant-col ant-col-24"
          style="padding-left: 8px; padding-right: 8px;"
        >
          <h5>
            Upload Signature
          </h5>
        </div>
      </div>
      <div
        class="ant-row"
      >
        <div
          class="ant-col ant-col-24"
        >
          <div
            class="filepond--wrapper"
          >
            <input
              accept="image/jpeg,image/png,image/jpeg,image/jp2,image/tiff,image/tiff,image/heic,image/heif"
              type="file"
            />
          </div>
        </div>
      </div>
      <div
        class="right center-mobile"
      >
        <button
          aria-label="Cancel"
          class="ant-btn ant-btn-default core-btn core-btn-default  form-btn"
          type="button"
        >
          <span>
            Cancel
          </span>
        </button>
        <button
          aria-label="Submit"
          class="ant-btn ant-btn-primary  form-btn"
          type="submit"
        >
          <span>
            Update Person
          </span>
        </button>
      </div>
    </form>
  </div>
</div>
`;
