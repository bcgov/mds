            class="ant-row contact-rows"
          >
            <div
              class="scroll"
            >
              <div
                class="ant-col ant-col-24"
                style="min-height: 150px;"
              >
                <h3>
                  Core Contact Detail
                </h3>
                <p>
                  Use this information to determine if this is the correct contact to use in Core for this application. Click "Select Contact" when you have found the right match. You may update the contact if the information is incorrect.
                </p>
              </div>
              <div
                class="ant-col ant-col-24 card--white"
              >
                <p
                  class="null"
                >
                  No Contact selected to verify
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="right center-mobile"
      >
        <p
          class="violet"
        >
          0/2 contacts confirmed
        </p>
        <p
          class="red"
        />
      </div>
    </form>
  </div>
</div>
`;
