                                            class="ant-typography view-item-value"
                                          >
                                            i.
                                          </div>
                                        </div>
                                        <div
                                          class="ant-col condition-column"
                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            Complete required reclamation works on disturbed areas must be conducted according to the site-specific reclamation plans that will ensure function as close as possible to natural pre-disturbance conditions;
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div>
                                <div
                                  class="condition-layer condition-layer--2 condition-CON fade-in "
                                >
                                  <div
                                    class="condition-collapsed"
                                  >
