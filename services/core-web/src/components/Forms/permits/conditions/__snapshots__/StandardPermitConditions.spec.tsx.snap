                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            iii.
                                          </div>
                                        </div>
                                        <div
                                          class="ant-col condition-column"
                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            Bridge abutments or other structures and materials must not be placed within the stream channel width. Rip-rap must be keyed into the stream bank and must not constrict the natural stream channel width;
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div>
                                <div
