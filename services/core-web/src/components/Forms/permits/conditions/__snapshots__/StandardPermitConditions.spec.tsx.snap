                                        class="ant-row ant-row-no-wrap ant-row-top condition-content "
                                      >
                                        <div
                                          class="ant-col step-column"
                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            iii.
                                          </div>
                                        </div>
                                        <div
                                          class="ant-col condition-column"
                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            Any materials, such as riprap or gabion rock, used for stream bank armouring must be clean and not contain substances that could be harmful to fish, wildlife or the aquatic ecosystem of the stream.
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
