                                          >
                                            i.
                                          </div>
                                        </div>
                                        <div
                                          class="ant-col condition-column"
                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            Damage above the high water mark to values such as banks and stream side (riparian) vegetation in the vicinity of the work area must be minimized. Unavoidable impacts that occur must be remedied as per the reclamation section below;
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div>
                                <div
                                  class="condition-layer condition-layer--2 condition-CON fade-in "
