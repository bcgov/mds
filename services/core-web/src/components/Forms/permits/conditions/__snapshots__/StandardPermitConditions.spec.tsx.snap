                                          >
                                            ii.
                                          </div>
                                        </div>
                                        <div
                                          class="ant-col condition-column"
                                        >
                                          <div
                                            class="ant-typography view-item-value"
                                          >
                                            The bridge and its approach roads do not produce a back water effect or increase the head of the stream;
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div>
