              style="margin-left: -8px; margin-right: -8px;"
            >
              <div
                class="ant-col ant-col-24"
                style="padding-left: 8px; padding-right: 8px;"
              >
                <h4
                  class="ant-typography"
                  id="incident-details"
                >
                  Incident Details
                </h4>
                <div
                  class="ant-typography"
                >
                  Enter more information regarding the reported incident. Some fields may be marked as optional but help the ministry understand the nature of the incident, please consider including them.
                </div>
              </div>
              <div
                class="ant-col ant-col-24"
                style="padding-left: 8px; padding-right: 8px;"
              >
                <div
                  class="ant-form-item ant-form-item-with-help"
                >
                  <div
                    class="ant-row ant-form-item-row"
                  >
                    <div
                      class="ant-col ant-form-item-label"
                    >
                      <label
                        class="ant-form-item-required"
                        for="ADD_EDIT_INCIDENT_incident_location"
                        title=""
                      >
                        <div
                          style="width: 100%;"
                        >
