                        </div>
                      </label>
                    </div>
                    <div
                      class="ant-col ant-form-item-control"
                    >
                      <div
                        class="ant-form-item-control-input"
                      >
                        <div
                          class="ant-form-item-control-input-content"
                        >
                          <input
                            aria-label="reported_by_name"
                            class="ant-input"
                            data-testid="reported_by_name"
                            id="reported_by_name"
                            name="reported_by_name"
                            placeholder="Enter name of reporter"
                            type="text"
                            value=""
                          />
                        </div>
                      </div>
                      <div
                        style="display: flex; flex-wrap: nowrap;"
                      >
                        <div
                          class="ant-form-item-explain ant-form-item-explain-connected"
                          id="ADD_EDIT_INCIDENT_reported_by_name_help"
                          role="alert"
                        >
                          <div
                            class=""
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="ant-col ant-col-xs-24 ant-col-md-10"
                style="padding-left: 8px; padding-right: 8px;"
              >
                <div
                  class="ant-form-item ant-form-item-with-help"
                >
                  <div
                    class="ant-row ant-form-item-row"
                  >
                    <div
                      class="ant-col ant-form-item-label"
                    >
                      <label
                        class="ant-form-item-required"
                        for="ADD_EDIT_INCIDENT_reported_by_phone_no"
                        title=""
                      >
                        <div
                          style="width: 100%;"
                        >
