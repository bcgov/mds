                        </div>
                      </label>
                    </div>
                    <div
                      class="ant-col ant-form-item-control"
                    >
                      <div
                        class="ant-form-item-control-input"
                      >
                        <div
                          class="ant-form-item-control-input-content"
                        >
                          <input
                            aria-label="reported_by_phone_no"
                            class="ant-input"
                            data-testid="reported_by_phone_no"
                            id="reported_by_phone_no"
                            name="reported_by_phone_no"
                            placeholder="xxx-xxx-xxxx"
                            type="text"
                            value=""
                          />
                        </div>
                      </div>
                      <div
                        style="display: flex; flex-wrap: nowrap;"
                      >
                        <div
                          class="ant-form-item-explain ant-form-item-explain-connected"
                          id="ADD_EDIT_INCIDENT_reported_by_phone_no_help"
                          role="alert"
                        >
                          <div
                            class=""
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="ant-col ant-col-xs-24 ant-col-md-4"
                style="padding-left: 8px; padding-right: 8px;"
              >
                <div
                  class="ant-form-item ant-form-item-with-help"
                >
                  <div
                    class="ant-row ant-form-item-row"
                  >
                    <div
                      class="ant-col ant-form-item-label"
                    >
                      <label
                        class=""
                        for="ADD_EDIT_INCIDENT_reported_by_phone_ext"
                        title=""
                      >
                        <div>
                          Ext.
                           
                          <span
                            class="form-item-optional"
                          >
                             (optional)
                          </span>
                        </div>
                      </label>
                    </div>
                    <div
                      class="ant-col ant-form-item-control"
                    >
                      <div
                        class="ant-form-item-control-input"
                      >
                        <div
                          class="ant-form-item-control-input-content"
                        >
                          <input
                            aria-label="reported_by_phone_ext"
                            class="ant-input"
                            data-testid="reported_by_phone_ext"
                            id="reported_by_phone_ext"
                            name="reported_by_phone_ext"
                            placeholder="xxxxxx"
                            type="text"
                            value=""
                          />
                        </div>
                      </div>
                      <div
                        style="display: flex; flex-wrap: nowrap;"
                      >
                        <div
                          class="ant-form-item-explain ant-form-item-explain-connected"
                          id="ADD_EDIT_INCIDENT_reported_by_phone_ext_help"
