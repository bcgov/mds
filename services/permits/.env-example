# Permit search index variables
AZURE_SEARCH_INDEX_NAME=permit-conditions
AZURE_SEARCH_DATA_SOURCE=permit-conditions-data
AZURE_SEARCH_INDEXER_NAME=permit-conditions-indexer
AZURE_SEARCH_SKILLSET=permit-conditions-skillset

# NoW search index variables
# Note: the data source and indexer cannot be updated in-place through the proxy (PUT is not
# supported). If you need to change the blob path query, use a new name for both the data source
# and indexer and re-run the setup command — the old resources can be cleaned up via the portal.
AZURE_NOW_SEARCH_INDEX_NAME=now-application-index
AZURE_NOW_SEARCH_DATA_SOURCE=now-application-ds-v3
AZURE_NOW_SEARCH_INDEXER_NAME=now-application-indexer-v3
AZURE_NOW_SEARCH_SKILLSET=now-application-skillset

